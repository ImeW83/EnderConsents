# Copy to .env and fill in. Never commit .env.

# Matches docker-compose.yml (database port is mapped to 5434 on the host)
DATABASE_URL="postgresql://enderconsents:enderconsents_dev_password@localhost:5434/enderconsents"

# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me"

# Optional
# PORT=3000
# REDIS_URL="redis://localhost:6379"

# Development only: allow http:// and localhost webhook targets. Never in production.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true
