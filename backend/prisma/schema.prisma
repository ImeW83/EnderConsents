generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANIZATION & ACCESS CONTROL
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free | starter | pro | enterprise
  status    String   @default("active") // active | suspended | cancelled
  createdAt DateTime @default(now())

  users      User[]
  roles      Role[]
  subjects   Subject[]
  purposes   Purpose[]
  notices    NoticeVersion[]
  apiKeys    ApiKey[]
  webhooks   Webhook[]
  auditRecords AuditRecord[]
  consentStates ConsentState[]
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, email])
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String   // e.g. "admin", "dpo", "viewer"
  permissions    String[] // e.g. ["consent:read", "consent:write", "purpose:manage"]

  users User[]

  @@unique([organizationId, name])
}

// ============================================================
// SUBJECT (the end customer / data subject)
// ============================================================

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  externalRef    String?
  email          String?
  phone          String?
  locale         String   @default("en")
  createdAt      DateTime @default(now())

  consentStates ConsentState[]
  identifiers   SubjectIdentifier[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model SubjectIdentifier {
  id           String   @id @default(uuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  type         String   // email | phone | external_ref | device_id
  valueHash    String   // hashed value, used for lookup
  valuePlain   String?  // plain value, nullable — omit for highly sensitive identifiers if required
  createdAt    DateTime @default(now())

  @@unique([type, valueHash])
  @@index([subjectId])
}

// ============================================================
// PURPOSE & VERSIONING
// ============================================================

model Purpose {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  name           String
  description    String
  category       String?
  isActive       Boolean  @default(true)

  versions      PurposeVersion[]
  consentStates ConsentState[]

  @@unique([organizationId, key])
}

model PurposeVersion {
  id            String   @id @default(uuid())
  purposeId     String
  purpose       Purpose  @relation(fields: [purposeId], references: [id])
  version       Int
  name          String
  description   String
  legalBasis    String?
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  consentStates ConsentState[]
  consentEvents ConsentEvent[]

  @@unique([purposeId, version])
}

// ============================================================
// PRIVACY NOTICE VERSIONING
// ============================================================

model NoticeVersion {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  version        Int
  language       String   @default("en")
  content        String
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  consentStates ConsentState[]
  consentEvents ConsentEvent[]

  @@unique([organizationId, version, language])
}

// ============================================================
// CONSENT CORE — STATE (snapshot) + EVENT (immutable history)
// ============================================================

model ConsentState {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  subjectId        String
  subject          Subject  @relation(fields: [subjectId], references: [id])
  purposeId        String
  purpose          Purpose  @relation(fields: [purposeId], references: [id])
  purposeVersionId String?
  purposeVersion   PurposeVersion? @relation(fields: [purposeVersionId], references: [id])
  noticeVersionId  String?
  noticeVersion    NoticeVersion? @relation(fields: [noticeVersionId], references: [id])
  status           String
  expiresAt        DateTime?
  updatedAt        DateTime @updatedAt

  events ConsentEvent[]

  @@unique([subjectId, purposeId])
  @@index([organizationId, status])
}

model ConsentEvent {
  id                 String   @id @default(uuid())
  seq                BigInt   @unique @default(autoincrement()) // global order, used as the pull-API cursor
  consentStateId     String
  consentState       ConsentState @relation(fields: [consentStateId], references: [id])
  action             String
  actorType          String
  actorId            String?
  channel            String
  ipAddress          String?
  userAgent          String?
  purposeVersionId   String?
  purposeVersion     PurposeVersion? @relation(fields: [purposeVersionId], references: [id])
  noticeVersionId    String?
  noticeVersion      NoticeVersion? @relation(fields: [noticeVersionId], references: [id])
  previousEventHash  String?
  eventHash          String
  timestamp          DateTime @default(now())
  expiresAt          DateTime? // expiry in force after this event; not part of the event hash

  receipt ConsentReceipt?

  @@index([consentStateId, timestamp])
}

model ConsentReceipt {
  id             String   @id @default(uuid())
  consentEventId String   @unique
  consentEvent   ConsentEvent @relation(fields: [consentEventId], references: [id])
  receiptHash    String
  payload        Json
  issuedAt       DateTime @default(now())
}

// ============================================================
// AUDIT
// ============================================================

model AuditRecord {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorType      String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  details        String?
  timestamp      DateTime @default(now())

  @@index([organizationId, timestamp])
}

// ============================================================
// API ACCESS & INTEGRATIONS
// ============================================================

model ApiKey {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String   @default("")
  keyPrefix      String   @default("") // first characters of the key, so users can tell keys apart
  hashedKey      String   @unique
  scopes         String[]
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
}

model Webhook {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  url            String
  description    String   @default("")
  events         String[] // event types, or "*" for all
  secret         String   // needed in plaintext to sign payloads (HMAC), unlike API keys
  previousSecret          String?   // still accepted during a rotation grace period
  previousSecretExpiresAt DateTime?
  isActive       Boolean  @default(true)
  disabledReason String?
  consecutiveFailures Int @default(0)
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]
}

// Transactional outbox: written in the same transaction as the consent event
// it describes, so a notification can never be lost between "saved" and "queued"
model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organizationId String
  eventType      String
  eventId        String?  // ConsentEvent id; null for test deliveries
  payload        Json
  status         String   @default("pending") // pending | delivered | failed
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?

  attemptLog WebhookAttempt[]

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

model WebhookAttempt {
  id            String   @id @default(uuid())
  deliveryId    String
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int
  statusCode    Int?
  error         String?
  durationMs    Int
  createdAt     DateTime @default(now())

  @@index([deliveryId, createdAt])
}

// Lets API clients safely retry a POST: same key + same request replays the
// original response instead of repeating the action
model IdempotencyKey {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  requestHash    String
  status         String   @default("in_progress") // in_progress | completed
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([organizationId, key])
  @@index([createdAt])
}